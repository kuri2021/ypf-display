 169   1        if(0==len)
 170   1          return;
 171   1        LenLimit = 0xffffU - addr + 1;
 172   1        if(LenLimit < len)
 173   1        {
 174   2          len = LenLimit;
 175   2        }
 176   1        OS_addr = addr >> 1;
 177   1        OS_addr_offset = addr & 0x01;
