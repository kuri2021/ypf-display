  41          //定时器时钟为系统时钟的12分频，最大能设定到3.8ms
  42          //计算公式为(65536-n*FOSC/12),其中n的单位为秒
  43          void T0_Init(void)
  44          {
  45   1          TMOD=0x11;          //16位定时器
  46   1          //T0
  47   1          TH0=0x00;
  48   1          TL0=0x00;
  49   1          TR0=0x00;
  50   1        
  51   1          OutTimeFlag=0;
  52   1          EnableTimer=0;
  53   1        
  54   1          TMOD|=0x01;
