 222          /* sys.c — 새 버전 구현 (len = 바이트 수) */
 223          void write_dgus_vp_new(u16 addr, u8 *buf, u16 len)
 224          {
 225   1          u16 LenLimit;
 226   1          u16 OS_addr;
 227   1          u8  OS_addr_offset;
 228   1          u16 OS_len4;
 229   1          u8  rem2;
 230   1      
 231   1          if (len == 0) return;
 232   1      
 233   1          /* 주소 범위 방어 */
 234   1          LenLimit = 0xFFFFu - addr + 1u;
 235   1          if (LenLimit < len) {
 236   2              len = LenLimit;
 237   2          }
 238   1      
 239   1          /* 워드 단위 주소/오프셋 계산 */
C51 COMPILER V9.56.0.0   SYS                                                               06/30/2026 10:00:44 PAGE 5   

 240   1          OS_addr        = (u16)(addr >> 1);   /* word index */
 241   1          OS_addr_offset = (u8)(addr & 0x01);  /* byte offset (0 or 1) */
 242   1      
 243   1      #ifdef INTVPACTION
 244   1          EA = 0;                             /* 필요 시 인터럽트 잠금 */
 245   1      #endif
 246   1      
 247   1          ADR_H   = 0;
 248   1          ADR_M   = (u8)(OS_addr >> 8);
 249   1          ADR_L   = (u8)(OS_addr);
 250   1          ADR_INC = 0x01;
 251   1      
 252   1          /* 선행 정렬 */
 253   1          RAMMODE = 0x83;
 254   1          while (!APP_ACK);
 255   1      
 256   1          /* 만약 시작 바이트가 홀수면, 먼저 2바이트 처리 */
 257   1          if (OS_addr_offset) {
 258   2              if (len < 2) {                 /* 비정상 요청 방어 */
 259   3                  RAMMODE = 0x00;
 260   3      #ifdef INTVPACTION
 261   3                  EA = 1;
 262   3      #endif
 263   3                  return;
 264   3              }
 265   2              /* 2바이트(1워드) */
 266   2              DATA1 = *buf++;                /* 상위 바이트 */
 267   2              DATA0 = *buf++;                /* 하위 바이트 */
 268   2              APP_EN = 1; while (APP_EN);
 269   2              len -= 2;
 270   2          }
 271   1      
 272   1          /* 4바이트 블록(= 2워드) 반복 */
 273   1          OS_len4 = (u16)(len >> 2);         /* 4-byte block count */
 274   1          RAMMODE = 0x8F;
 275   1          while (OS_len4--) {
 276   2              DATA3 = *buf++;
 277   2              DATA2 = *buf++;
 278   2              DATA1 = *buf++;
 279   2              DATA0 = *buf++;
 280   2              APP_EN = 1; while (APP_EN);
 281   2          }
 282   1      
 283   1          /* 2바이트 남은 경우 처리 */
 284   1          rem2 = (u8)((len & 0x02) ? 1 : 0);
 285   1          if (rem2) {
 286   2              RAMMODE = 0x8C;
 287   2              DATA3 = *buf++;
 288   2              DATA2 = *buf++;
 289   2              APP_EN = 1; while (APP_EN);
 290   2          }
 291   1      
 292   1          RAMMODE = 0x00;
 293   1      
 294   1      #ifdef INTVPACTION
 295   1          EA = 1;
 296   1      #endif
 297   1      }
