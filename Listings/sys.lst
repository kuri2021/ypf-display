              void BackLight_Control(u8 light)
              {
                u16 DATA_RAM;
C51 COMPILER V9.56.0.0   SYS                                                               06/30/2026 10:00:44 PAGE 12  

                u16 DATA_RAM1;
                read_dgus_vp(0x0082,(u8*)&DATA_RAM,1);
