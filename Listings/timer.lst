  55   1          TH0=T1MS>>8;        //1ms定时器
  56   1          TL0=T1MS;
  57   1          ET0=1;              //开启定时器0中断
  58   1          EA=1;               //开总中断
  59   1          TR0=1;              //开启定时器
  60   1      }
  61          /*****************************************************************************
  62           函 数 名  : void T0_ISR_PC(void)    interrupt 1
