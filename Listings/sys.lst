 434          void delay_us(unsigned int t)
 435          { 
 436   1       u8 i;
 437   1      
 438   1       while(t)
 439   1       {
 440   2        for(i=0;i<50;i++)
 441   2         {i=i;}
 442   2        t--;
 443   2       }
 444   1      }
