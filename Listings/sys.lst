              //���ư�������������  0�ر�  1����  2����
              void system_config(u8 is_beep,u8 is_sleep)
              {
                u8 config_cmd[4];
                read_dgus_vp(0x0080,config_cmd,2);
                if(is_beep == 1)
                {
                  config_cmd[3] |= (1<<3);
                }
                else if(is_beep == 0)
                {
                  config_cmd[3] &= ~(1<<3);
                }
                else 
                {
                  ;
                }
                
                if(is_sleep == 1)
                {
                  config_cmd[3] |= (1<<2);
                }
                else if(is_sleep == 0)
                {
                  config_cmd[3] &= ~(1<<2);
                }
                else 
                {
                  ;
                }
                config_cmd[0] = 0x5A;
                write_dgus_vp(0x0080,config_cmd,2);
              }
              
