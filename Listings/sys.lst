 446          void Page_Change(u16 PageID)
 447          {
 448   1        u8 buf[4];
 449   1        
 450   1        buf[0] = 0x5a;
 451   1        buf[1] = 0x01;
 452   1        buf[2] = (u8)(PageID >> 8);
 453   1        buf[3] = (u8)PageID;
 454   1        write_dgus_vp(0x84,buf,2);
 455   1        do
 456   1        {
 457   2          delay_us(500);
 458   2          read_dgus_vp(0x14,buf,2);
 459   2        }while(*(u16*)buf!=PageID);
 460   1        buf[0] = 0;
 461   1        buf[1] = 0;
 462   1        buf[2] = 0;
 463   1        buf[3] = 0;
 464   1        write_dgus_vp(0x16,buf,2);
 465   1      }
