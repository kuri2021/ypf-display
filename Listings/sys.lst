 162          void write_dgus_vp(u16 addr, u8 *buf, u16 len)
 163          {
 164   1        u16 OS_addr = 0;
 165   1        u16 OS_addr_offset = 0;
 166   1        u16 OS_len = 0,OS_len_offset = 0;
