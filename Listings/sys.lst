 182   1        ADR_M = (u8)(OS_addr >> 8);
 183   1        ADR_L = (u8)OS_addr;
 184   1        ADR_INC = 0x01; 
 185   1        RAMMODE = 0x83;
 186   1        while (!APP_ACK);
 187   1        if (OS_addr_offset)
 188   1        {
 189   2          DATA1 = *buf++;
 190   2          DATA0 = *buf++;
 191   2          APP_EN = 1;
 192   2          while (APP_EN);
 193   2          len--;
 194   2        }
 195   1        OS_len = len >> 1;
 196   1        OS_len_offset = len & 0x01;
