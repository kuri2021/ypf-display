 120          //定时器时钟为系统时钟的24分频，最大能设定到7.6ms
 121          //计算公式为(65536-n*FOSC/24),其中n的单位为秒
 122          void T2_Init(void)
 123          {
 124   1        T2CON = 0xF0;   //选择24分频
 125   1        
 126   1        TH2 = 0x58;
 127   1        TL2 = 0x00;
 128   1        TRL2H = 0x58;
 129   1        TRL2L = 0x00;   //定时5ms
 130   1        T2CON |= 0x01;  //启动定时器
 131   1        ET2 = 1;        //打开定时器2中断   
 132   1      }
