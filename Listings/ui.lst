 586          void addLogtest(u16 type, u16 value)
 587          {
 588   1          int i;
 589   1      
 590   1          if(logCount < LOG_MAX)
 591   1          {
 592   2              logs[logCount].type = type;
 593   2              logs[logCount].value = value;
 594   2      
 595   2              logCount++;
 596   2          }
 597   1          else
 598   1          {
 599   2              for(i = 0; i < LOG_MAX - 1; i++)
 600   2              {
 601   3                  logs[i] = logs[i + 1];
 602   3              }
 603   2      
 604   2              logs[LOG_MAX - 1].type = type;
 605   2              logs[LOG_MAX - 1].value = value;
 606   2          }
 607   1      
 608   1          updateLogs();
 609   1      }
