 252   1      }
 253          
 254          void check_End(){
 255   1          check_active = 0;
 256   1          check_count = 0;
 257   1      }
 258          
 259          void write_dgus_vp_check(void) {
 260   1           if (!check_active) return; 
 261   1           if (GetTimeOutFlag(TMR_6)) {
 262   2              read_dgus_vp(check_addr, (u8*)&recoll_value, 1);
 263   2          if(legacy_value == recoll_value){
 264   3              check_End();
 265   3          }else if(check_count < 2){
 266   3              check_Start(check_addr, legacy_value);
 267   3              check_count++;
 268   3          }
 269   2          } 
 270   1      }
