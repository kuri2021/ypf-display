 181          /*旋转编码器模拟增量调节
 182            @unit_value 单位变化值，每次变化的幅度
 183            @upper_limit_value 设置的上限值
 184            @lower_limiting_value 设置的下限值
 185            @set_value 需要设置的值
 186          通过判断旋转编码器的转动情况来设置一个值，顺时针增加，逆时针减少，
 187            增加的值超过上限值后，会回到下限值。同理，减少时也是。
 188          适用场景：只存在一个固定的单位变化值，且上限和下限明确。
 189              目前只存在最小为0的下限值，上限值不要超过u16的范围
 190          */
 191          u16 Encoder_Set_Value(u16 unit_value,u16 upper_limit_value,u16 lower_limiting_value,u16 set_value)
 192          {
 193   1        u16 encoder_tmp = 0;      //设置时间
 194   1        encoder_tmp = Encoder_recevie();
 195   1        if(encoder_tmp == 1)
 196   1        {
 197   2          if(set_value < upper_limit_value)
 198   2          {
 199   3            set_value += unit_value;
 200   3          }
 201   2          else if(set_value >= upper_limit_value)
 202   2          {
 203   3            set_value = lower_limiting_value;
 204   3          }
 205   2        }
 206   1        else if(encoder_tmp == 2)
 207   1        {
 208   2          if(set_value > lower_limiting_value)
 209   2          {
 210   3            set_value -= unit_value;
 211   3          }
 212   2          else if(set_value <= lower_limiting_value)
 213   2          {
 214   3            set_value = upper_limit_value;
 215   3          }       
 216   2        }
 217   1        return set_value;
 218   1      }


