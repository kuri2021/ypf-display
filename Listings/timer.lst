  71          void T0_ISR_PC(void)    interrupt 1
  72          {
  73   1         u8 data i;
  74   1        
  75   1          EA=0;
  76   1          TH0=T1MS>>8;
  77   1          TL0=T1MS;
  78   1        SysTick++;
  79   1      //    Uart_timer();
  80   1          for(i=0;i<8;i++)
  81   1          {
  82   2            if(EnableTimer&(0x01<<i))
  83   2            {
  84   3              TimerTime[i]--;
  85   3              if(TimerTime[i]==0)
  86   3              {
  87   4                OutTimeFlag |= 0x01<<i;
  88   4                EnableTimer &= ~(0x01<<i);           
  89   4              }
  90   3            }
  91   2          }
  92   1          EA=1;
  93   1      }
  94          //定时器时钟为系统时钟的12分频，最大能设定到3.8ms
  95          //计算公式为(65536-n*FOSC/12),其中n的单位为秒
  96          void T1_Init(void)
  97          {
  98   1          TMOD=0x11;          //16位定时器
  99   1          //T1
 100   1          TH1=0x00;
