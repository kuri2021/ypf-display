 788          void Picture1213_Init(void) {
 789   1          u16 result = 0;
 790   1      
 791   1          read_dgus_vp(VP_SET_P, (u8*)&press, 1);
 792   1      
 793   1          //상판 설정 온도
 794   1          read_dgus_vp(VP_SET_TT, (u8*)&result, 1);
 795   1          TT100 = result / 100;
 796   1          TT10   = (result / 10) % 10;
 797   1          TT1     = result % 10;
 798   1      
 799   1          read_dgus_vp(VP_SET_TB, (u8*)&result, 1);
 800   1          BT100 = result / 100;
 801   1          BT10   = (result / 10) % 10;
 802   1          BT1     = result % 10;
 803   1      
 804   1          read_dgus_vp(VP_SET_H, (u8*)&time_result, 1); 
 805   1          ShowMMSS(time_result);  
 806   1      
