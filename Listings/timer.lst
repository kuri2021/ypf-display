 154          *****************************************************************************/
 155          void StartTimer(u8 ID, u16 nTime)
 156          {
 157   1          EA=0;
 158   1          EnableTimer=EnableTimer|(1<<ID);
 159   1          TimerTime[ID]=nTime;
 160   1          OutTimeFlag&=~(1<<ID);
 161   1          EA=1; 
 162   1      }
