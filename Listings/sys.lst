 467          void delay_ms(u16 t)
 468          {
 469   1        u16 i,j;
 470   1          for(i=0;i<t;i++)
 471   1          {
 472   2            for(j=0;j<300;j++)
 473   2             delay_us(1);
 474   2          }
 475   1      }
