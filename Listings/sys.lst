 511          void PinOutput(u8 Port,u8 Pin,u8 value)
 512          {
 513   1        switch(Port)
 514   1        {
 515   2          case 0: if(value) P0|=(1<<Pin);
 516   2              else      P0&=~(1<<Pin);
 517   2              break;
 518   2          case 1: if(value) P1|=(1<<Pin);
 519   2              else      P1&=~(1<<Pin);
 520   2              break;
 521   2          case 2: if(value) P2|=(1<<Pin);
 522   2              else      P2&=~(1<<Pin);
 523   2              break;
 524   2          case 3: if(value) P3|=(1<<Pin);
 525   2              else      P3&=~(1<<Pin);
 526   2              break;  
 527   2          default:break;        
 528   2        }
 529   1      }
