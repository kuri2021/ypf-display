 617          void addLogtest(u16 type, u16 value){
 618   1          int i;
 619   1      
 620   1          if(logCount < LOG_MAX)
 621   1          {
 622   2              logs[logCount].type = type;
 623   2              logs[logCount].value = value;
 624   2      
 625   2              logCount++;
 626   2          }
 627   1          else
 628   1          {
 629   2              for(i = 0; i < LOG_MAX - 1; i++)
 630   2              {
 631   3                  logs[i] = logs[i + 1];
 632   3              }
 633   2      
 634   2              logs[LOG_MAX - 1].type = type;
 635   2              logs[LOG_MAX - 1].value = value;
 636   2          }
 637   1      
 638   1          updateLogs();
 639   1      }
