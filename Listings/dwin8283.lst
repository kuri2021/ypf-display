  46          #ifdef ENABLE_CRC
              u16 Calculate_CRC16_8283(u8 *updata, u16 len)
              {
                  u16 Reg_CRC=0xffff;
                  u16 i;
                  u8 j;
                  u16 crctmp;
              
                  for (i=0;i<len;i++)
C51 COMPILER V9.56.0.0   DWIN8283                                                          06/30/2026 09:33:11 PAGE 2   

                  {
                      Reg_CRC^=*updata++;
                      for (j=0;j<8;j++)
                      {
                          if (Reg_CRC & 0x0001)
                          {
                             Reg_CRC=Reg_CRC>>1^0XA001;
                          }
                          else
                          {
                             Reg_CRC>>=1;
                          }
                      }
                  }
                  crctmp = Reg_CRC << 8;
                  crctmp |= (Reg_CRC>>8);
                  // *updata++ = (u8)Reg_CRC;
                  // *updata = (u8)(Reg_CRC>>8);
                  return crctmp;
              }
              #endif
